// aieo · .vscode/tasks.json — fleet-vscode/v1 · 2026-09-09. Convention + vocabulary: .vscode/README.md.
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Serve",
      "detail": "Host python + Docker. `make dev`: brings postgres/redis up (docker compose), then uvicorn with --reload on http://localhost:8000. Runs until Stop.",
      "type": "shell",
      "command": "make dev",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": {
        "owner": "serve",
        "pattern": {
          "regexp": "^(never-matches)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Application startup complete|Uvicorn running"
        }
      }
    },
    {
      "label": "Frontend: serve",
      "detail": "Host node. The Vite dev server (frontend/) on http://localhost:5173.",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": {
        "owner": "serve",
        "pattern": {
          "regexp": "^(never-matches)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Local:\\s+https?://|Container \\S+\\s+Running"
        }
      }
    },
    {
      "label": "Stop",
      "detail": "Stops the Docker services (make down). Close the Serve terminal to stop uvicorn.",
      "type": "shell",
      "command": "make down",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Build",
      "detail": "Host node. The frontend production build (release.yml).",
      "type": "shell",
      "command": "npm run build",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Lint",
      "detail": "Host python. ruff + mypy on backend/.",
      "type": "shell",
      "command": "make lint",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Test",
      "detail": "Host python. pytest on backend/.",
      "type": "shell",
      "command": "make test",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Verify",
      "detail": "Host. Lint, then the backend tests — ci.yml's backend job. Frontend: lint + test is the frontend job.",
      "type": "shell",
      "command": "make lint && make test",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "Frontend: lint + test",
      "detail": "Host node. ci.yml's frontend job.",
      "type": "shell",
      "command": "npm run lint && npm test -- --watchAll=false",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Setup: verify install",
      "detail": "Host. scripts/verify.sh — checks the local install end to end.",
      "type": "shell",
      "command": "make verify",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Claude: session",
      "detail": "Interactive Claude Code in this repo with its .claude/agents + skills, on your logged-in credentials. House rules still apply: branch from main, open a PR, a human merges.",
      "type": "shell",
      "command": "claude",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": true
      }
    }
  ]
}
